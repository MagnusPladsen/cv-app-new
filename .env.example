# Where beta feedback is sent. Without it the feedback box says plainly that it
# is not wired to a destination, rather than pretending to send.
NEXT_PUBLIC_FEEDBACK_EMAIL=

# Supabase (optional). With these unset, CVApp runs exactly as it does in
# beta: everything local, no accounts, no sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated, opt-in. Empty means no sign-in buttons at all. Set to
# "google" once Google is enabled in the Supabase dashboard, and
# "google,apple" once Sign in with Apple is too.
NEXT_PUBLIC_AUTH_PROVIDERS=
