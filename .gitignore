# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents the variables and holds no secrets.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Vitest
/coverage

# Playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Real CVs used to measure the importer against. Never committed: this
# repository is public, and these are other people's personal data - the exact
# thing the rest of the app goes to some trouble never to hold.
/import examples/
/test-cvs/

# Local Claude Code settings. Plugins tried out here stay on this machine.
/.claude/

# The OCR engine and its language models, fetched by scripts/fetch-ocr-assets.mjs.
/public/ocr/
